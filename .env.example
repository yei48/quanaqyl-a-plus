# Public values: Supabase Project Settings / API (or Connect dialog).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# SECRET: Connect / Transaction pooler (port 6543). Keep server-side only.
# Copy the actual pooler hostname from Supabase; do not guess the region.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@YOUR_POOLER_HOST:6543/postgres

# Optional PEM CA certificate if your connection requires a custom trusted CA.
# DATABASE_SSL_CERT=
